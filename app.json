{
  "expo": {
    "name": "mongle",
    "slug": "mongle",
    "version": "1.0.0",
    "scheme": "mongle",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "몽글이 구름 사진을 찍기 위해 카메라 접근 권한이 필요해요."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "몽글이 촬영 장소를 기록하기 위해 위치 접근 권한이 필요해요."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
